DECLARE @cols NVARCHAR(MAX);
DECLARE @sql NVARCHAR(MAX);

-- Build the column list using FOR XML PATH to ensure NVARCHAR(MAX)
SELECT @cols = STUFF((
    SELECT 
        ', ' + 
        CASE 
            WHEN MAX(CASE WHEN TABLE_NAME = 'Table1' THEN 1 ELSE 0 END) = 1 
             AND MAX(CASE WHEN TABLE_NAME = 'Table2' THEN 1 ELSE 0 END) = 1 
                THEN 'ISNULL(T1.' + QUOTENAME(COLUMN_NAME) + ', T2.' + QUOTENAME(COLUMN_NAME) + ') AS ' + QUOTENAME(COLUMN_NAME)
            WHEN MAX(CASE WHEN TABLE_NAME = 'Table1' THEN 1 ELSE 0 END) = 1 
                THEN 'T1.' + QUOTENAME(COLUMN_NAME) + ' AS ' + QUOTENAME(COLUMN_NAME)
            WHEN MAX(CASE WHEN TABLE_NAME = 'Table2' THEN 1 ELSE 0 END) = 1 
                THEN 'T2.' + QUOTENAME(COLUMN_NAME) + ' AS ' + QUOTENAME(COLUMN_NAME)
        END
    FROM INFORMATION_SCHEMA.COLUMNS 
    WHERE TABLE_SCHEMA = 'core' 
      AND TABLE_NAME IN ('Table1','Table2')
    GROUP BY COLUMN_NAME
    FOR XML PATH(''), TYPE
).value('.', 'NVARCHAR(MAX)'), 1, 2, '');

-- Build the final dynamic SQL for the view
SET @sql = 'CREATE VIEW core.CombinedView AS
SELECT ' + @cols + '
FROM core.Table1 T1
FULL OUTER JOIN core.Table2 T2
  ON T1.series_name = T2.series_name;';

-- Debug: display the full generated SQL
SELECT @sql AS GeneratedSQL;

-- Execute the dynamic SQL to create the view
EXEC sp_executesql @sql;
