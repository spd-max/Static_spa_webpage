private byte[] GenerateServiceTicket()
{
    if (string.IsNullOrEmpty(Spn) || Spn.Equals("localhost", StringComparison.OrdinalIgnoreCase))
    {
        return null;
    }

    // Note: In .NET 8, AppDomain.SetPrincipalPolicy is often unnecessary 
    // if the process is already running under the desired Windows Identity.

    try 
    {
        // 1. Initialize the provider (requires System.ServiceModel.Security NuGet)
        var tokenProvider = new System.ServiceModel.Security.Tokens.KerberosSecurityTokenProvider(Spn);
        
        // 2. Request the token
        // Use GetTokenAsync if possible, but for a synchronous library:
        var securityToken = tokenProvider.GetToken(TimeSpan.FromMinutes(1)) 
                            as System.ServiceModel.Security.Tokens.KerberosRequestorSecurityToken;

        // 3. Extract the raw ticket bytes
        return securityToken?.GetRequest();
    }
    catch (Exception ex)
    {
        // Log error - common issues in .NET 8 involve SPN format 
        // or missing Kerberos configuration on the client machine.
        throw; 
    }
}
