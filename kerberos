using System.Net;
using System.Net.Security;
using System.Security.Principal;
using System.Text;

public static class KerberosSspi
{
    public static byte[] GetApReq(string spn)
    {
        var target = new SspiTarget(spn);

        using var context = new SspiContext(
            CredentialCache.DefaultNetworkCredentials,
            target,
            ContextFlags.MutualAuth | ContextFlags.Confidentiality);

        // First leg – ask Windows to generate the Kerberos AP-REQ
        var token = context.Init(null);

        if (token == null || token.Length == 0)
            throw new InvalidOperationException("Kerberos token not generated");

        return token; // This is the Kerberos AP-REQ
    }
}

private byte[] GenerateServiceTicket()
{
    if (string.IsNullOrWhiteSpace(Spn) ||
        Spn.Equals("localhost", StringComparison.OrdinalIgnoreCase))
    {
        return null;
    }

    return KerberosSspi.GetApReq(Spn);
}