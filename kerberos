using System.Net;
using System.Net.Security;
using System.Net.Sockets;
using System.Security.Principal;

private byte[] GenerateServiceTicket()
{
    if (string.IsNullOrWhiteSpace(Spn) ||
        Spn.Equals("localhost", StringComparison.OrdinalIgnoreCase))
    {
        return null;
    }

    return KerberosSspi.GetApReq(Spn);
}


internal static class KerberosSspi
{
    public static byte[] GetApReq(string spn)
    {
        // SPN like: COH/cluster01.mycorp.com
        string host = spn.Substring(spn.IndexOf('/') + 1);

        // We only need a TCP socket so SSPI can talk to the KDC
        using var socket = new Socket(SocketType.Stream, ProtocolType.Tcp);
        socket.Connect(host, 7574);   // Coherence proxy port (or any open port)

        using var stream = new NetworkStream(socket, ownsSocket: true);
        using var negotiate = new NegotiateStream(stream, leaveInnerStreamOpen: true);

        negotiate.AuthenticateAsClient(
            CredentialCache.DefaultNetworkCredentials,
            spn,
            ProtectionLevel.None,
            TokenImpersonationLevel.Impersonation
        );

        // This is the Kerberos AP-REQ (same as GetRequest())
        return negotiate.GetOutgoingBlob();
    }
}