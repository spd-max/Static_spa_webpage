CREATE PROCEDURE GetSeriesByAttributes
    @FilterCriteria FilterTableType READONLY -- Accept user input as a parameter
AS
BEGIN
    SET NOCOUNT ON;

    -- Step 1: Declare variables for dynamic SQL
    DECLARE @Columns NVARCHAR(MAX), @FilterConditions NVARCHAR(MAX), @DynamicSQL NVARCHAR(MAX);

    -- Step 2: Dynamically identify relevant attributes from user-provided filter
    SELECT @Columns = STRING_AGG(QUOTENAME(ATTRIBUTE), ',') WITHIN GROUP (ORDER BY ATTRIBUTE)
    FROM (SELECT DISTINCT ATTRIBUTE FROM @FilterCriteria) AS Attrs;

    -- Step 3: Generate filter conditions for WHERE clause
    SELECT @FilterConditions = STRING_AGG(
        'p.' + QUOTENAME(ATTRIBUTE) + ' = f.ATTRIBUTE_VALUE AND f.ATTRIBUTE = ''' + ATTRIBUTE + '''',
        ' AND '
    ) WITHIN GROUP (ORDER BY ATTRIBUTE)
    FROM (SELECT DISTINCT ATTRIBUTE FROM @FilterCriteria) AS Attrs;

    -- Ensure the variables are treated as NVARCHAR(MAX)
    SET @Columns = CAST(@Columns AS NVARCHAR(MAX));
    SET @FilterConditions = CAST(@FilterConditions AS NVARCHAR(MAX));

    -- Step 4: Construct and execute the dynamic SQL
    SET @DynamicSQL = '
        -- Step 4.1: Create a pivoted table with relevant attributes
        SELECT SERIES_NAME, ' + @Columns + '
        INTO #PivotedTable
        FROM (
            SELECT SERIES_NAME, ATT_NAME, ATT_VALUE
            FROM YourTable
            WHERE ATT_NAME IN (SELECT DISTINCT ATTRIBUTE FROM @FilterCriteria) -- Filter only relevant attributes
        ) AS SourceTable
        PIVOT (
            MAX(ATT_VALUE) FOR ATT_NAME IN (' + @Columns + ')
        ) AS PivotTable;

        -- Step 4.2: Filter the pivoted table based on user input
        SELECT DISTINCT p.SERIES_NAME
        INTO #MatchingSeries
        FROM #PivotedTable p
        JOIN @FilterCriteria f
            ON (' + @FilterConditions + ');

        -- Step 4.3: Retrieve all rows from the original table for matching series
        SELECT t.*
        FROM YourTable t
        JOIN #MatchingSeries s
            ON t.SERIES_NAME = s.SERIES_NAME;

        -- Cleanup temporary tables
        DROP TABLE #PivotedTable;
        DROP TABLE #MatchingSeries;
    ';

    -- Execute the dynamic SQL
    EXEC sp_executesql @DynamicSQL, N'@FilterCriteria FilterTableType READONLY', @FilterCriteria = @FilterCriteria;
END;