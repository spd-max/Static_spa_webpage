pipeline {
    agent any

    stages {
        stage('Get Latest Artifact') {
            steps {
                script {
                    // Simulated JSON response (Replace with actual API call)
                    def jsonData = '''
                    {
                      "results": [
                        { "uri": "https://domain/path/1.2.0.5/file.jar" },
                        { "uri": "https://domain/path/1.3.0.2-RC/file.jar" },
                        { "uri": "https://domain/path/2.0.0.10-SNAPSHOT/file.jar" },
                        { "uri": "https://domain/path/1.10.0.1/file.jar" },
                        { "uri": "https://domain/path/2.0.0.15/file.jar" },
                        { "uri": "https://domain/path/21.1.0.375/file.jar" },
                        { "uri": "https://domain/path/19.2.4578.0/file.jar" }
                      ]
                    }
                    '''

                    // Parse JSON
                    def json = new groovy.json.JsonSlurper().parseText(jsonData)
                    def uris = json.results*.uri

                    // Extract versions using regex
                    def versions = uris.collect { uri ->
                        def matcher = (uri =~ /(\d+\.\d+\.\d+\.\d+(-SNAPSHOT|-RC)?)/)
                        return matcher ? matcher[0][0] : null
                    }.findAll { it != null }

                    // Function to parse and compare versions
                    def parseVersion = { version ->
                        def cleanVersion = version.replaceAll(/-SNAPSHOT|-RC/, "")
                        def parts = cleanVersion.tokenize('.').collect { it.toInteger() }
                        return [
                            major: parts[0],
                            minor: parts[1],
                            patch: parts[2],
                            build: parts[3],
                            stability: version.endsWith("-RC") ? 1 : version.endsWith("-SNAPSHOT") ? 2 : 0 // 0 = stable, 1 = RC, 2 = SNAPSHOT
                        ]
                    }

                    // Custom comparator for proper sorting
                    def compareVersions = { a, b ->
                        def aParts = parseVersion(a)
                        def bParts = parseVersion(b)

                        return aParts.major <=> bParts.major ?:
                               aParts.minor <=> bParts.minor ?:
                               aParts.patch <=> bParts.patch ?:
                               aParts.build <=> bParts.build ?:
                               aParts.stability <=> bParts.stability
                    }

                    // Sort versions properly
                    versions.sort(compareVersions)

                    // Get the latest version
                    def latestVersion = versions[-1]
                    echo "Latest Version: ${latestVersion}"

                    // Find the matching URI
                    def latestUri = uris.find { it.contains("/${latestVersion}/") }
                    echo "Processing: ${latestUri}"

                    // Set as environment variables for later use
                    env.LATEST_VERSION = latestVersion
                    env.LATEST_URI = latestUri
                }
            }
        }
    }
}