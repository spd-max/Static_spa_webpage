import requests

url = "https://your-jira-instance/rest/api/2/issue/ABC-1235"
params = {"fields": "parent"}
headers = {"Authorization": "Bearer YOUR_API_TOKEN"}

response = requests.get(url, params=params, headers=headers).json()
parent_key = response.get("fields", {}).get("parent", {}).get("key")
print(parent_key)  # Outputs: PARENT-456