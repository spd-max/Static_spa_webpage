pipeline {
    agent any

    stages {
        stage('Find Latest Version') {
            steps {
                script {
                    def jsonData = '''
                    {
                      "results": [
                        { "uri": "https://domain/path/1.2.0.5/file.jar" },
                        { "uri": "https://domain/path/1.3.0.2-RC/file.jar" },
                        { "uri": "https://domain/path/2.0.0.10-SNAPSHOT/file.jar" },
                        { "uri": "https://domain/path/1.10.0.1/file.jar" },
                        { "uri": "https://domain/path/2.0.0.15/file.jar" }
                      ]
                    }
                    '''

                    def latestVersionInfo = findLatestVersion(jsonData)
                    echo "Latest Version: ${latestVersionInfo.version}"
                    echo "URI: ${latestVersionInfo.uri}"
                }
            }
        }
    }
}

// Groovy Method to Extract Latest Version (Fixed)
def findLatestVersion(String jsonString) {
    def json = new groovy.json.JsonSlurper().parseText(jsonString)
    def versionPattern = ~/(\d+)\.(\d+)\.(\d+)\.(\d+)/

    def latest = json.results.collect { item ->
        def match = (item.uri =~ versionPattern)
        if (match.find()) {
            def major = match[0][1].toInteger()
            def minor = match[0][2].toInteger()
            def patch = match[0][3].toInteger()
            def build = match[0][4].toInteger()
            return [major, minor, patch, build, item.uri]
        }
        return null
    }.findAll { it != null }
    .max { a, b -> [0, 1, 2, 3].findResult { i -> a[i] <=> b[i] ?: null } ?: 0 }

    return latest ? [version: "${latest[0]}.${latest[1]}.${latest[2]}.${latest[3]}", uri: latest[4]] : null
}