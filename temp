pipeline {
    agent any

    stages {
        stage('Find Latest Version') {
            steps {
                script {
                    def jsonData = '''
                    {
                      "results": [
                        { "uri": "https://domain/path/1.2.0.5/file.jar" },
                        { "uri": "https://domain/path/1.3.0.2-RC/file.jar" },
                        { "uri": "https://domain/path/2.0.0.10-SNAPSHOT/file.jar" },
                        { "uri": "https://domain/path/1.10.0.1/file.jar" },
                        { "uri": "https://domain/path/2.0.0.15/file.jar" }
                      ]
                    }
                    '''

                    def latestVersionInfo = findLatestVersion(jsonData)
                    echo "Latest Version: ${latestVersionInfo.version}"
                    echo "URI: ${latestVersionInfo.uri}"
                }
            }
        }
    }
}

// Jenkins Function for Finding Latest Version using PowerShell
def findLatestVersion(String jsonString) {
    def jsonFilePath = 'data.json'
    writeFile file: jsonFilePath, text: jsonString

    try {
        def result = powershell(script: """
            \$jsonFile = '${jsonFilePath}'
            \$jsonData = Get-Content -Raw -Path \$jsonFile | ConvertFrom-Json
            \$pattern = '(\\d+)\\.(\\d+)\\.(\\d+)\\.(\\d+)'

            \$versions = @()

            foreach (\$item in \$jsonData.results) {
                if (\$item.uri -match \$pattern) {
                    \$major, \$minor, \$patch, \$build = \$matches[1..4] -as [int[]]
                    \$versions += [PSCustomObject]@{
                        Major   = \$major
                        Minor   = \$minor
                        Patch   = \$patch
                        Build   = \$build
                        Uri     = \$item.uri
                    }
                }
            }

            \$latest = \$versions | Sort-Object Major, Minor, Patch, Build -Descending | Select-Object -First 1

            if (\$latest) {
                Write-Output "\$($latest.Major).\$($latest.Minor).\$($latest.Patch).\$($latest.Build)|\$($latest.Uri)"
            } else {
                Write-Output "NoVersion|NoURI"
            }

            Remove-Item -Force \$jsonFile
        """, returnStdout: true).trim()

        def parts = result.split("\\|")
        return [version: parts[0], uri: parts[1]]
    } finally {
        // Ensure the file is deleted even if an error occurs
        deleteFile(jsonFilePath)
    }
}

// Helper function to delete a file in Jenkins workspace
def deleteFile(String filePath) {
    try {
        if (fileExists(filePath)) {
            sh "rm -f ${filePath}"
        }
    } catch (Exception e) {
        echo "Warning: Failed to delete ${filePath} - ${e.getMessage()}"
    }
}