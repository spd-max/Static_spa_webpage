pipeline {
    agent any
    environment {
        ARTIFACTORY_URL = 'https://artifactory.example.com/path/to/jar/MyApplication.jar'
        LOCAL_JAR = 'workspace\\MyApplication.jar'
        ARTIFACTORY_JAR = 'workspace\\ArtifactoryJar.jar'
    }
    stages {
        stage('Fetch Artifactory JAR') {
            steps {
                script {
                    // Download the JAR from Artifactory
                    bat "curl -o ${ARTIFACTORY_JAR} %ARTIFACTORY_URL%"
                }
            }
        }
        stage('Compare JARs') {
            steps {
                script {
                    // Extract version from local JAR
                    def localVersion = bat(
                        script: "findstr Implementation-Version META-INF\\MANIFEST.MF",
                        returnStdout: true
                    ).trim().split(':')[1].trim()

                    // Extract version from Artifactory JAR
                    bat "unzip -o ${ARTIFACTORY_JAR} META-INF/MANIFEST.MF -d workspace"
                    def artifactoryVersion = bat(
                        script: "findstr Implementation-Version workspace\\META-INF\\MANIFEST.MF",
                        returnStdout: true
                    ).trim().split(':')[1].trim()

                    // Calculate size
                    def localSize = bat(
                        script: "for %I in (${LOCAL_JAR}) do @echo %~zI",
                        returnStdout: true
                    ).trim()
                    def artifactorySize = bat(
                        script: "for %I in (${ARTIFACTORY_JAR}) do @echo %~zI",
                        returnStdout: true
                    ).trim()

                    // Calculate checksum
                    def localChecksum = bat(
                        script: "certutil -hashfile ${LOCAL_JAR} SHA256 | findstr -v certutil",
                        returnStdout: true
                    ).trim()
                    def artifactoryChecksum = bat(
                        script: "certutil -hashfile ${ARTIFACTORY_JAR} SHA256 | findstr -v certutil",
                        returnStdout: true
                    ).trim()

                    // Compare all aspects
                    if (localVersion == artifactoryVersion &&
                        localSize == artifactorySize &&
                        localChecksum == artifactoryChecksum) {
                        echo "JARs are identical. Skipping further steps."
                        currentBuild.result = 'SUCCESS'
                        return
                    } else {
                        echo "JARs are different. Proceeding with the build."
                    }
                }
            }
        }
        stage('Perform Build Steps') {
            when {
                expression {
                    currentBuild.result != 'SUCCESS'
                }
            }
            steps {
                echo "Performing the build as the JARs are different..."
                // Add your build steps here
            }
        }
    }
}




pipeline {
    agent any

    stages {
        stage('Get Latest Artifact') {
            steps {
                powershell '''
                $jsonData = (Invoke-RestMethod -Uri "<artifactory-api-url>").Content
                $uris = ($jsonData | ConvertFrom-Json).results.uri

                $versions = $uris | ForEach-Object {
                    if ($_ -match "([0-9]+\\.[0-9]+(\\.[0-9]+)?(-SNAPSHOT|-RC)?)") {
                        $matches[0]
                    }
                }

                $sortedVersions = $versions | Sort-Object { $_ -replace "-SNAPSHOT|-RC", "" } -Descending
                $latestVersion = $sortedVersions[0]

                Write-Output "Latest Version: $latestVersion"

                $latestUri = $uris | Where-Object { $_ -match "/$latestVersion/" }
                Write-Output "Processing: $latestUri"
                '''
            }
        }
    }
}



pipeline {
    agent any

    stages {
        stage('Get Latest Artifact') {
            steps {
                script {
                    // Simulated JSON response (Replace with actual API call)
                    def jsonData = '''
                    {
                      "results": [
                        { "uri": "https://domain/path/1.2.0/file.jar" },
                        { "uri": "https://domain/path/1.3.0-RC/file.jar" },
                        { "uri": "https://domain/path/2.0.0-SNAPSHOT/file.jar" },
                        { "uri": "https://domain/path/1.10.0/file.jar" },
                        { "uri": "https://domain/path/2.0.0/file.jar" }
                      ]
                    }
                    '''

                    // Parse JSON
                    def json = new groovy.json.JsonSlurper().parseText(jsonData)
                    def uris = json.results*.uri

                    // Extract versions using regex
                    def versions = uris.collect { uri ->
                        def matcher = (uri =~ /(\d+\.\d+(\.\d+)?(-SNAPSHOT|-RC)?)/)
                        return matcher ? matcher[0][0] : null
                    }.findAll { it != null }

                    // Sort versions (natural sorting)
                    versions.sort { a, b -> 
                        def aClean = a.replaceAll(/-SNAPSHOT|-RC/, "")
                        def bClean = b.replaceAll(/-SNAPSHOT|-RC/, "")
                        def compare = new groovy.util.VersionNumber(aClean) <=> new groovy.util.VersionNumber(bClean)
                        return compare == 0 ? a <=> b : compare
                    }

                    // Get the latest version
                    def latestVersion = versions[-1]
                    echo "Latest Version: ${latestVersion}"

                    // Find the matching URI
                    def latestUri = uris.find { it.contains("/${latestVersion}/") }
                    echo "Processing: ${latestUri}"

                    // Set as environment variables for later use
                    env.LATEST_VERSION = latestVersion
                    env.LATEST_URI = latestUri
                }
            }
        }
    }
}

